  },
  "homepage": "https://github.com/vstyler96/x.css",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "chokidar": "^3.3.1",
    "cssnano": "^5.0.1",
    "dedent": "^0.7.0",
    "ejs": "^3.1.8",
    "gh-pages": "^2.2.0",
    "glob": "^7.1.6",
